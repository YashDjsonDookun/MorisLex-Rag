# MORISLEX-RAG — copy to .env and adjust
# Data directory (overrides configs/app.yaml ingest.data_directory)
# Example: path to MorisLex-Engine data folder
# DATA_DIR=/path/to/MorisLex-Engine/data

# LLM (Ollama or LM Studio)
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3

# Logging
# LOG_LEVEL=INFO

# Streamlit port (default 8502)
# STREAMLIT_PORT=8502

# Obsidian vault root (for make sync-blueprints-to-obsidian / sync-blueprints-to-engine)
# OBSIDIAN_VAULT=/Users/djson/Library/Mobile Documents/com~apple~CloudDocs/Obsidian-Vault
